# Postgres connection string.
#
# OPTIONAL. Without it the app builds and runs fine: the "Mon mariage"
# selections are then kept in the browser (localStorage) only, and the API
# answers { persistence: "local_only" }.
#
# In production use a POOLED endpoint (Neon pooler, Supabase pgBouncer),
# not a direct connection: serverless functions exhaust direct connections.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
